@model List<ContactMessage>
@{
    ViewData["Title"] = "Messages";
    ViewData["Nav"] = "";
    ViewData["NoIndex"] = true;
    ViewData["AdminTab"] = "messages";
}

<div class="container section">
    <partial name="_AdminNav" />

    <h2>Messages</h2>

    @if (Model.Count == 0)
    {
        <p class="muted">No messages yet.</p>
    }

    @foreach (var m in Model)
    {
        <article class="msg @(m.IsRead ? "" : "unread")">
            <div class="msg-head">
                <div>
                    <strong>@m.Name</strong> · <a href="mailto:@m.Email">@m.Email</a>
                </div>
                <span class="muted">@m.CreatedAt.ToString("MMM d, yyyy HH:mm", CultureInfo.InvariantCulture) UTC</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(m.Subject))
            {
                <h3>@m.Subject</h3>
            }
            <p class="msg-body">@m.Message</p>
            <div class="actions">
                <form asp-action="ToggleRead" asp-route-id="@m.Id" method="post" class="inline-form">
                    <button class="btn btn-small" type="submit">@(m.IsRead ? "Mark unread" : "Mark read")</button>
                </form>
                <form asp-action="DeleteMessage" asp-route-id="@m.Id" method="post" class="inline-form" data-confirm="Delete this message?">
                    <button class="btn btn-small btn-danger" type="submit">Delete</button>
                </form>
            </div>
        </article>
    }
</div>
