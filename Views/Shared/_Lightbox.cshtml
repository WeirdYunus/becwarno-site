<dialog id="lightbox" class="lightbox" aria-label="Image viewer">
    <div class="lightbox-inner">
        <button type="button" class="btn btn-small lb-close" data-lightbox-close>Close ✕</button>
        <img alt="" />
        <p class="lb-cap"></p>
        <a class="btn btn-small btn-solid lb-link" target="_blank" rel="noopener noreferrer" hidden>View on Etsy →</a>
    </div>
</dialog>
