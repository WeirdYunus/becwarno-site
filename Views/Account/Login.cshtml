@model LoginViewModel
@{
    ViewData["Title"] = "Admin login";
    ViewData["Nav"] = "";
    ViewData["NoIndex"] = true;
}

<div class="container section">
    <div class="section-head">
        <span class="eyebrow">Restricted</span>
        <h1>Admin</h1>
    </div>

    <form class="form form-narrow" asp-action="Login" asp-controller="Account" method="post">
        <input type="hidden" name="returnUrl" value="@(ViewData["ReturnUrl"] as string)" />
        <div asp-validation-summary="ModelOnly" class="field-error"></div>

        <div class="field">
            <label for="Username">Username</label>
            <input asp-for="Username" type="text" required autocomplete="username" />
            <span asp-validation-for="Username" class="field-error"></span>
        </div>
        <div class="field">
            <label for="Password">Password</label>
            <input asp-for="Password" type="password" required autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <div><button class="btn btn-solid" type="submit">Sign in</button></div>
    </form>
</div>
